<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The About page opens QQ and Telegram on their own deep links, and both are probed with
        resolveActivity first, which package visibility would otherwise answer with null. The
        tg scheme entry covers every Telegram client; the three packages cover QQ, TIM and QQ
        International, which is all openQqGroup ever aims at.
    -->
    <!--
        The self-updater. INTERNET is install-time and never prompted. There is deliberately no
        REQUEST_INSTALL_PACKAGES: this app does not install anything itself any more, it hands the
        downloaded APK to an installer app, and the permission that matters is that app's.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.tim" />
        <package android:name="com.tencent.mobileqqi" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <!--
            The APK intent, so the updater can tell a device with no installer at all apart from
            one that took the file. No installer is named: which app handles this is the user's
            choice, made in Settings.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperMusicCover">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HyperMusicCover"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:label="@string/third_party_licenses_title"
            android:theme="@style/Theme.HyperMusicCover" />

        <!--
            The module declares itself through META-INF/xposed/ now (java_init.list, module.prop,
            scope.list), which is how API 102 does it. These stay so a manager still lists the app
            as a module, and minversion is 102 so anything that only understands the classic API
            refuses it outright rather than loading it half way and failing at the entry point,
            which no longer exists in the old shape.
        -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="HyperMusicCover by zyl6932 - album art as the HyperOS lock screen wallpaper, with the clock collapsed" />
        <meta-data android:name="xposedminversion" android:value="102" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />

        <!--
            Only ever serves the downloaded release to an installer app. Not exported, and the
            single path it exposes is a cache directory this app clears on every attempt.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
