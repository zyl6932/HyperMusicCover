<?xml version="1.0" encoding="utf-8"?>
<!--
    The same drawing as ic_about_logo.xml and the launcher icon, framed for the splash screen.

    A splash icon is not an adaptive icon, so nothing masks it and nothing scales it into a safe
    area - it is drawn as-is inside a square frame that clips. So the mask is done by hand here:
    a rounded square filling the middle 72x72 of the 108 canvas, which is the area an adaptive
    icon's mask would show, with a corner radius in the same proportion as the squircle the
    About page clips its copy with (28 of 100). The artwork is the About logo's paths, unchanged,
    scaled by 72/108 so it sits inside that square at the same proportions it has there.

    Nothing may animate outside the rounded square: growing the background ran it into the frame
    and cut its edges off. Only the record turns; see splash_icon_animated.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:name="root"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M38,18h32a20,20 0 0 1 20,20v32a20,20 0 0 1 -20,20h-32a20,20 0 0 1 -20,-20v-32a20,20 0 0 1 20,-20z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18" android:startY="18"
                android:endX="90" android:endY="90"
                android:type="linear">
                <item android:offset="0" android:color="#FF2B3A8F" />
                <item android:offset="0.55" android:color="#FF6C3BC4" />
                <item android:offset="1" android:color="#FFC2478F" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:name="art"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.6667"
        android:scaleY="0.6667">
        <clip-path
            android:name="mask"
            android:pathData="M38,18h32a20,20 0 0 1 20,20v32a20,20 0 0 1 -20,20h-32a20,20 0 0 1 -20,-20v-32a20,20 0 0 1 20,-20z" />

        <!-- the sleeve, peeking out behind the record -->
        <path
            android:name="sleeve"
            android:pathData="M26,27.5h32a5,5 0 0 1 5,5v36a5,5 0 0 1 -5,5h-32a5,5 0 0 1 -5,-5v-36a5,5 0 0 1 5,-5z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.32" />

        <!-- the record: the one thing that moves -->
        <group
            android:name="record"
            android:pivotX="62"
            android:pivotY="55.5">

            <path
                android:pathData="M62,55.5m-25,0a25,25 0 1,0 50,0a25,25 0 1,0 -50,0"
                android:fillColor="#FFFFFF" />

            <!-- grooves -->
            <path
                android:pathData="M62,55.5m-18,0a18,18 0 1,0 36,0a18,18 0 1,0 -36,0"
                android:strokeColor="#33000000"
                android:strokeWidth="1.6"
                android:fillColor="#00000000" />
            <path
                android:pathData="M62,55.5m-12,0a12,12 0 1,0 24,0a12,12 0 1,0 -24,0"
                android:strokeColor="#26000000"
                android:strokeWidth="1.4"
                android:fillColor="#00000000" />

            <!--
                The one thing this copy has that the About logo does not: two opposed sheen arcs.
                They are dark because the record is white, and they exist because everything else
                on it is a concentric circle - without something off-axis, turning the record
                changes nothing on screen and the animation is invisible.
            -->
            <path
                android:pathData="M62,55.5m0,-23a23,23 0 0,1 16.26,6.74"
                android:strokeColor="#3D000000"
                android:strokeWidth="2.9"
                android:strokeLineCap="round"
                android:fillColor="#00000000" />
            <path
                android:pathData="M62,55.5m0,23a23,23 0 0,1 -16.26,-6.74"
                android:strokeColor="#26000000"
                android:strokeWidth="2.3"
                android:strokeLineCap="round"
                android:fillColor="#00000000" />

            <!-- spindle hole -->
            <path
                android:pathData="M62,55.5m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
                android:fillColor="#FF6C3BC4" />
        </group>
    </group>
</vector>
