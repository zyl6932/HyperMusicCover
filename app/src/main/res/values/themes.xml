<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window background is what fills the gap between the splash screen going away and
        Compose's first frame. Material.Light's default made that gap a white flash; MainActivity
        paints over this with the surface colour the app last drew (see LaunchBackground), so this
        value is only what a first-ever launch starts from.
    -->
    <style name="Theme.HyperMusicCover" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <!--
            A static vector, deliberately: HyperOS draws an animated splash icon on a
            SurfaceView and, when the app takes over the splash exit, moves that SurfaceView into
            the app window while the splash window above it is still an opaque black layer. For a
            frame the icon is in neither and visibly blinks. Static-icon splash windows on this
            build have no SurfaceView in the window logs, so there is nothing to move.
        -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
