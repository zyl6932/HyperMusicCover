+    /**
+     * Re-derives the floor from the OEM's own accounting, or leaves the constant alone.
+     *
+     * Called at the top of an entry and nowhere else, because the floor must not move under a
+     * collapse that is already in flight or already held: p is measured against it, so a floor
+     * that changes mid-entry is a jump in every value derived from p. At entry there is no
+     * collapse to disturb, and the one reading that has to be taken BEFORE the hold goes on is
+     * the container translation - taking the hold is exactly what stops the OEM putting the
+     * clock into the layout that translation describes.
+     *
+     * Every failure here is a name on someone else's build, and none of them is a reason to stop
+     * collapsing the clock: the fallback is the constant this device has always used.
+     */
+    private static void learnFloorY() {
+        View v = sContainer;
+        float natural = sLastSystemY;
+        if (v == null || Float.isNaN(natural)) return;
+        // Never while a hold is on: notifPre is `C - y` for whatever y went in last, and under a
+        // hold that is OUR y, so the C recovered from it would belong to nobody.
+        if (sHoldY != null) return;
+        // The OEM's own collapsed translation on clock_animation_container, read while the OEM
+        // is still the one setting it. Zero means this style does not translate the container at
+        // all, in which case there is no OEM answer to read and the constant stands.
+        float refT = containerTy();
+        if (!(refT < -0.5f)) return;
+        try {
+            Object it = Xp.getObjectField(v, "keyguardClockNotifInteractor");
+            if (it == null) return;
+            Object pre = Xp.getObjectField(it, "notifPre");
+            Object space = Xp.getObjectField(it, "maxSpace");
+            if (!(pre instanceof Number) || !(space instanceof Number)) return;
+            // notifPre is `C - y` for the y the OEM last drove, so `C = notifPre + y` recovers
+            // the device's own constant, and the translation knee is that minus its max space.
+            float c = ((Number) pre).floatValue() + natural;
+            float knee = c - ((Number) space).intValue();
+            float floor = knee + refT;
+            // A knee read off a notifPre belonging to a different layout is the one way this goes
+            // wrong, so it is only believed inside the band a real one lands in: this device's
+            // derives 740 of a 1438 natural, i.e. 51%. Anything outside is dropped with the
+            // numbers in the log rather than applied.
+            if (!(floor > natural * 0.2f && floor < natural * 0.9f)) {
+                Xp.log(TAG + "floor: derived " + r1(floor) + " (C " + r1(c) + " knee "
+                        + r1(knee) + " refT " + r1(refT) + ") out of range, keeping "
+                        + r1(sFloorY));
+                return;
+            }
+            if (Math.abs(floor - sFloorY) < 0.5f) return;
+            Xp.log(TAG + "floor: " + r1(sFloorY) + " -> " + r1(floor) + " (natural "
+                    + r1(natural) + " notifPre " + r1(((Number) pre).floatValue()) + " maxSpace "
+                    + ((Number) space).intValue() + " knee " + r1(knee) + " refT " + r1(refT)
+                    + ")");
+            sFloorY = floor;
+        } catch (Throwable t) {
+            Xp.log(TAG + "floor: derivation unavailable, keeping " + r1(sFloorY) + ": " + t);
+        }
+    }
